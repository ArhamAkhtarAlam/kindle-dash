<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.arham.kindle-watch</string>
    <key>ProgramArguments</key>
    <array><string>/bin/bash</string><string>-c</string><string>$HOME/bin/kindle-watch</string></array>
    <key>StartInterval</key><integer>300</integer>
    <key>RunAtLoad</key><true/>
    <key>StandardErrorPath</key><string>/tmp/kindle-watch.log</string>
</dict>
</plist>
